# Copy to .env and fill in real values (.env is gitignored and never committed).
# ⚠ The placeholder values below deliberately do NOT have the shape of real keys: push
# protection blocks a push when a tracked file contains a string that looks like a secret.

# OpenRouter key — chat and embedding calls (cloud tier, A/B harness).
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=<see openrouter.ai/keys>

# Digital Policy Alert key — REST channel of the regulation registry.
# The MCP channel needs no key.
DPA_API_KEY=<issued by DPA on request>

# --- Cloudflare R2: offsite backup of original source files ---
#
# Bucket with public access disabled. The token is created in the dashboard:
# R2 -> API tokens -> Create ACCOUNT API token, permission `Object Read & Write`,
# scoped to that one bucket.
#
# ⚠ The token page shows THREE different values. S3 access needs the second and third;
# the first (Token value) does not work with the REST API at all under object-level
# permissions and is not stored in .env.
#   Access Key ID      — exactly 32 hex characters
#   Secret Access Key  — 64 hex characters, shown ONCE
#
# Scope check (expected behaviour, not a fault): ListBuckets returns 403 — the token is
# limited to the object level; operations inside the bucket itself succeed.
R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<32 hex from the R2 token page>
R2_SECRET_ACCESS_KEY=<64 hex, shown once at creation>

# --- Local bge-m3 model (bge-m3-onnx-int8) ---
#
# The tokenizer is needed ALWAYS (canonical token counter for chunking, whatever the
# embedder); the ONNX weights only for the local embedding fallback.
#
# CONTRACT for the code that will read this — the path is resolved, never hardcoded:
#   1. BGE_MODEL_DIR from the environment or from .env;
#   2. a repository-local directory as a backward-compatible fallback;
#   3. otherwise a clear error naming both the variable and where to download the model.
# Resolve LAZILY, inside a function — .env is read by entry points, not at import time, so
# a module-level constant would be computed before the variable ever became visible.
# Do NOT quote the value: .env is parsed line by line and quotes would land inside the path.
BGE_MODEL_DIR=<absolute path to the bge-m3-onnx-int8 directory>
