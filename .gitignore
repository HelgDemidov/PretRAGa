# Secrets — never tracked. The template is .env.example, which carries placeholders only.
.env

# Internal working docs and process notes — not for public distribution.
# Three exceptions, all versioned on purpose. docs/core/ holds the product
# charters; docs/design_truth/ is the truth system's section (generated views
# and its specs) — its history and CI checks have to exist; docs/backlog/ is
# the open-work register: an unversioned backlog is one nobody sees and nobody
# updates. Contents are excluded first, then the subtrees are re-included (a
# directory cannot be re-included if the directory itself is excluded).
/docs/*
!/docs/core/
!/docs/design_truth/
!/docs/backlog/
/.claude/*
!/.claude/commands/
!/.claude/hooks/
/.serena/

# Local environment, not portable — recreate, do not copy.
.venv/

# Tool and test caches. Listed here even when the tool writes its own
# self-ignoring file inside the directory (Grimp does, for the import-linter
# cache): that file is the tool's convenience, not our contract — it vanishes
# with the next clean or the next release, and the hole is invisible until it
# is not.
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
.import_linter_cache/
.coverage
.coverage.*
htmlcov/
