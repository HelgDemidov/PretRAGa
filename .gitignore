# Secrets — never tracked. The template is .env.example, which carries placeholders only.
.env

# Internal working docs and process notes — not for public distribution.
# Two exceptions, both versioned on purpose. docs/system_design/ is the
# architectural truth (entity map, glossary, vision): its history and its CI
# checks have to exist. docs/backlog/ is the open-work register: an unversioned
# backlog is one nobody sees and nobody updates, and it names nothing the
# tracked hole registry in the truth README does not already say out loud.
# Contents are excluded first, then the two subtrees are re-included (a
# directory cannot be re-included if the directory itself is excluded).
/CLAUDE.md
/docs/*
!/docs/system_design/
!/docs/backlog/
/.claude/
/.serena/

# Local environment, not portable — recreate, do not copy.
.venv/

# Tool and test caches.
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
