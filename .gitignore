# Secrets — never tracked. The template is .env.example, which carries placeholders only.
.env

# Internal working docs and process notes — not for public distribution.
# Exception: docs/system_design/ is the architectural truth (entity map, glossary,
# vision) — it MUST be versioned so its history and CI checks exist. Contents are
# excluded first, then the truth subtree is re-included (a directory cannot be
# re-included if the directory itself is excluded).
/CLAUDE.md
/docs/*
!/docs/system_design/
/.claude/
/.serena/

# Local environment, not portable — recreate, do not copy.
.venv/

# Tool and test caches.
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
